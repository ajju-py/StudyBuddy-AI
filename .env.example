# StudyBuddy AI - Environment Configuration Example
# Copy this file to .env and fill in your actual API credentials.
# NEVER commit your real .env file to version control.

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Application Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Configuration
# SQLite local path or PostgreSQL URI for production
DATABASE_URL=sqlite:///./studybuddy.db
STORAGE_DIR=./data/uploads

# Security Limits
MAX_UPLOAD_SIZE_MB=15
MAX_AGENT_TOOL_ITERATIONS=5
